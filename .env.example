# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env for local runs.  On Vercel set these in
#  Project → Settings → Environment Variables (.env is NOT deployed).
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub ──
GITHUB_USERNAME=DHURJATI-JS
# Optional but recommended: raises the GitHub API limit from 60 to 5,000 requests/hour.
# Fine-grained token → "Public repositories (read-only)" is enough. https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Admin login (/admin) ──
ADMIN_USERNAME=admin
# At least 8 characters. Or leave empty and use ADMIN_PASSWORD_HASH (python scripts/hash_password.py).
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie. Long random string (python -c "import secrets;print(secrets.token_hex(32))").
SECRET_KEY=
SESSION_HOURS=8

# ── Contact details shown on the site (editable later in /admin) ──
CONTACT_EMAIL=dhurjatisharma2010@gmail.com
CONTACT_WHATSAPP=+917208555047

# ── AI #1: your OpenAI-compatible gateway ──
AI_PRIMARY_URL=http://192.168.0.226:8000/v1
AI_PRIMARY_KEY=change-me-gateway-key
AI_PRIMARY_MODEL=gemma

# ── AI #2 (failsafe): local Docker Gemma 3 12B via Ollama  (scripts/start-fallback-ai.ps1) ──
AI_FALLBACK_URL=http://127.0.0.1:11434/v1
AI_FALLBACK_KEY=ollama
AI_FALLBACK_MODEL=gemma3:12b

# Seconds to wait for a connection / for the answer. README text sent to the AI (characters).
AI_CONNECT_TIMEOUT=4
AI_READ_TIMEOUT=180
AI_README_CHARS=6000
AI_MAX_TOKENS=1100

# ── Storage: the single JSON file with repo details + AI summaries + profile ──
#   local = data/portfolio.json   |   gist = a GitHub Gist (persistent admin edits on Vercel)
STORAGE_BACKEND=local
DATA_FILE=data/portfolio.json
GIST_ID=
GIST_TOKEN=
GIST_FILENAME=portfolio.json
# Create the Gist + Vercel variables in one go:  python scripts/setup_gist.py --vercel-env https://<your-site>.vercel.app
# (needs GITHUB_TOKEN = fine-grained token: Public repositories read-only + Account permission "Gists: Read and write")

# ── Cloudflare quick tunnel to your gateway (free, no domain) ──
# scripts/start-tunnel.ps1 publishes the current https://xxxx.trycloudflare.com URL into this Gist file;
# on Vercel the site reads it from there instead of AI_PRIMARY_URL.
AI_ENDPOINT_FILE=ai-endpoint.json

# ── Web / security ──
SITE_URL=
# Who may call the public JSON API from the browser ("*" = everyone) - comma separated.
CORS_ORIGINS=*
# Who may embed the public pages in an <iframe>: * , 'self' , 'none' or a list of origins. /admin is never embeddable.
FRAME_ANCESTORS=*
# memory:// (per process) or e.g. rediss://default:PASSWORD@HOST:6379 (add "redis" to requirements.txt)
RATELIMIT_STORAGE_URI=memory://
ENABLE_DOCS=false

# ── Automation ──
# Local/self-hosted: re-sync GitHub and AI-categorise NEW repos in the background.
AUTO_SYNC=true
AUTO_SYNC_MINUTES=60
# Vercel Cron (vercel.json → /api/cron/sync daily). Vercel sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
