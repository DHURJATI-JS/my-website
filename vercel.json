{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
